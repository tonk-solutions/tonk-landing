#!/bin/sh
# Regla de AGENTS.md: lo que se empuja a main va a nombre de Rodrigo Hernandez.
# Cubre el caso de mergear localmente una rama con commits de otra persona.
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue

  # Borrar la rama remota no empuja commits.
  case "$local_sha" in
    *[!0]*) ;;
    *) continue ;;
  esac

  # main nuevo en el remoto: no hay rango contra el cual comparar.
  case "$remote_sha" in
    *[!0]*) ;;
    *)
      echo "check-authors: main todavía no existe en el remoto; se omite la verificación." >&2
      continue
      ;;
  esac

  node scripts/check-authors.mjs "$remote_sha..$local_sha" || status=1
done

exit $status
